# SmartDSP ALSA Configuration
#
# Generated by install/configure-audio.sh
#
# SMARTDSP_CAPTURE_CARD and SMARTDSP_PLAYBACK_CARD are replaced
# during configuration.

pcm.SMARTDSP_CAPTURE {
    type plug
    slave {
        pcm "hw:CARD=SMARTDSP_CAPTURE_CARD,DEV=0"
        rate 192000
        channels 2
        format S32_LE
    }
}

pcm.SMARTDSP_PLAYBACK {
    type plug
    slave {
        pcm "hw:CARD=SMARTDSP_PLAYBACK_CARD,DEV=0"
        rate 192000
        channels 2
        format S32_LE
    }
}
